<!doctype html>
<html>
{% include 'head.html' %}
<div class=main>
{% include 'nav.html' %}
<body>
	<form action="{{u}}" method=POST enctype="multipart/form-data">{% csrf_token %}
		<table>
			<tr>
				<td>Lastname</td>
				<td><input id=lastname name=lastname type=text value="{{lastname}}"></td>
			</tr>
			<tr>
				<td>Firstname</td>
				<td><input id=firstname name=firstname type=text value="{{firstname}}"></td> 
			</tr>
			<tr>
				<td>Nickname</td>
				<td><input id=nickname name=nickname type=text value="{{nickname}}"></td>
			</tr>
			<tr>
				<td>Gender</td>
				<td>
					<select id=gender name=gender>
						<option value="">-----</option>
						{% if gender == "Male" %}
							<option value="Male" selected>Male</option>
						{% else %}
							<option value="Female" selected>Female</option>
						{% endif %}
					</select>
				</td>
			</tr>
			<tr>
				<td>Address</td>
				<td><input id=address name=address type=textbox value="{{address}}"></td>
			</tr>
			<tr>
				<td>Nationality</td>
				<td><input id=nationality name=nationality type=text value="{{nationality}}"></td>
			</tr>
			<tr>
				<td>Birth Date</td>
				<td><input id=birthdate name=birthdate type=date value="{{birthdate}}"></td>
			</tr>
			<tr>
				<td>Food Allergy</td>
				<td><input id=alllergy name=allergy type=textbox value="{{allergy}}"></td>
			</tr>
			<tr>
				<td>Mobile No.</td>
				<td><input id=mobile name=mobile type=text value="{{mobile}}"></td>
			</tr>
			<tr>
				<td>Parent's Name</td>
				<td><input id=parentsname name=parentsname type=text value="{{parentsname}}"></td>
			</tr>
			<tr>
				<td>Are you part of a DGroup?</td>
				<td>
					{% if dgroupmember == "Yes" %}
						<input type=radio id=yes name=dgroupmember value="Yes" checked />
						<label for=yes>Yes</label>
						<input type=radio id=no name=dgroupmember value="No" />
						<label for=no>No</label>
					{% elif dgroupmember == "No" %}
						<input type=radio id=yes name=dgroupmember value="Yes" />
						<label for=yes>Yes</label>
						<input type=radio id=no name=dgroupmember value="No" checked />
						<label for=no>No</label>
					{% else %}
						<input type=radio id=yes name=dgroupmember value="Yes" />
						<label for=yes>Yes</label>
						<input type=radio id=no name=dgroupmember value="No" />
						<label for=no>No</label>
					{% endif %}
				</td>
				<td>If Yes, Name of your DGroup Leader:</td>
				<td><input type=text id=pdglead name=pdglead value="{{pdglead}}"></td>
			</tr>
			<tr>
				<td>Email Address</td>
				<td><input id=emailadd name=emailadd type=text value={{email_add}}></td>
			</tr>
			<tr>
				<td>Guardian 1</td>
				<td><input id=guardian1 name=guardian1 type=text value="{{guardian1}}"></td>
			</tr>
			<tr>
				<td>Guardian 2</td>
				<td><input id=guardian2 name=guardian2 type=text value="{{guardian2}}"></td>
			</tr>
			<tr>
				<td><img src=/static/photo/{{u}}.jpg></td>
				<td>Select Photo</td>
				<td><input type=file name=imagefile></td>
			</tr>
			<tr>
					<td>
						<figure>
						<img src=/static/qr/{{u}}.png>
						<figcaption style="text-align:center">{{firstname}} {{lastname}}</figcaption>
						</figure>
					</td>
			</tr>
		</table>
		<input type=submit value=Update>
	</form>
	<div class=register>
	<table border=1>
		<tr>
			<td>ID number</td>
			<td>Name</td>
		</tr>
		{% for i in v %}
		<tr>
			<td><a href='rgstr/{{i.0}}'>{{i.0}}</a></td>
			<td>{{i.1}}</td>
		</tr>
		{% endfor %}
	</table>
	</div>
	</div>
</body>
</html>
