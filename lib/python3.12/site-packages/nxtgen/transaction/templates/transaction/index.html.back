<!doctype html>
<html>
{% include '/static/html/header.html' %}
<script src="https://cdn.logwork.com/widget/digital.js"></script>
<a href="https://logwork.com/current-time-in-santa-rosa-philippines-negros-occidental" class="digital-clock" data-style="style1" data-size="350" data-timezone="Asia/Manila" data-language="en" data-format="12" data-date="1" data-seconds="1">NxtGen KiDs In-Out</a>

<body>
	<div id="header"></div>
	Transaction
	<form method=POST action="/transaction/">{% csrf_token %}
		<input type=text id=k_id name=k_id />

	</form>
	<table>
		<tr>
			<td><img src='/static/photo/{{l.register.k_id}}.jpg'></td>
		</tr>
		<tr>
			<td>{{l.register.lastname}}, {{l.register.firstname}}</td>
		</tr>
		<tr>
			<td>{{l.register.k_id}}</td>
		</tr>
		<tr>
			<td>{{o}}</td>
		</tr>
	</table>
</body>
</div>
</html>
