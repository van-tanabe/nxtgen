<html>
<head>
    <title>HTML in 10 Simple Steps or Less</title>
    <meta http-equiv="refresh" content="5"> <!-- See the difference? -->
</head>
<h1>Attendance</h1>
	<ul>
		<li><a href='service/255'>Service 255</a></li>
		<li><a href='service/0'>Service 0</a></li>
		<li><a href='service/1'>Service 1</a></li>
		<li><a href='service/2'>Service 2</a></li>
		<li><a href='service/3'>Service 3</a></li>
	</ul>

	<ul>
		<li>
			Service 255
			<ul>
				{% for x in '01234'|make_list %}
				<li><a href='service/255/{{forloop.counter0}}'>Level {{forloop.counter0}}</a></li>
			{% endfor %}
			</ul>
		</li>
		<li>
			Service 0
			<ul>
				{% for x in '01234'|make_list %}
				<li><a href='service/0/{{forloop.counter0}}'>Level {{forloop.counter0}}</a></li>
			{% endfor %}
			</ul>
		</li>
		
		<li>
			Service 1 
			<ul>
				{% for x in '01234'|make_list %}
				<li><a href='service/1/{{forloop.counter0}}'>Level {{forloop.counter0}}</a></li>
			{% endfor %}
			</ul>
		</li>
		<li>
			Service 2 
			<ul>
				{% for x in '01234'|make_list %}
				<li><a href='service/2/{{forloop.counter0}}'>Level {{forloop.counter0}}</a></li>
			{% endfor %}
			</ul>
		</li>
		<li>
			Service 3 
			<ul>
				{% for x in '01234'|make_list %}
				<li><a href='service/3/{{forloop.counter0}}'>Level {{forloop.counter0}}</a></li>
			{% endfor %}
			</ul>
		</li>



	</ul>

</html>
